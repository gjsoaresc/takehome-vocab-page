{
  "name": "@vocab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/zod-validator": "^0.7.6",
    "@vocab/shared": "workspace:*",
    "hono": "^4.11.9",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./db": "./src/db.ts"
  }
}
